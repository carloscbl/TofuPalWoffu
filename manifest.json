{
  "manifest_version": 3,
  "name": "TofuPalWoffu",
  "description": "Registra automáticamente la jornada en Woffu con el horario de cada día.",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "cookies", "alarms", "notifications"],
  "host_permissions": [
    "https://*.woffu.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.woffu.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
