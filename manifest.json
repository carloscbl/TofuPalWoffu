{
  "manifest_version": 3,
  "name": "TofuPalWoffu",
  "description": "Asiste con el fichaje en Woffu con vista previa en modo dry-run.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.woffu.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.woffu.com/*"],
      "js": ["scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
